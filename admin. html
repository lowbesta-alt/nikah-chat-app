<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — InshaAllah</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="config.js"></script>
</head>
<body class="bg-slate-900 min-h-screen text-slate-100">
  <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-40">
    <div class="max-w-4xl mx-auto flex items-center justify-between px-4 py-3">
      <div class="flex items-center gap-2 font-bold">
        <span class="text-xl">⚙️</span><span>Admin — InshaAllah</span>
      </div>
      <nav class="flex items-center gap-3 text-sm">
        <a href="dashboard.html" class="text-slate-300 hover:text-white">Site</a>
        <button onclick="logout()" class="text-red-400 hover:underline">Déco</button>
      </nav>
    </div>
  </header>

  <main class="max-w-4xl mx-auto p-4 space-y-6">

    <!-- STATS -->
    <div class="grid grid-cols-3 gap-3">
      <div class="bg-slate-800 rounded-xl p-3 text-center">
        <p class="text-xs text-slate-400">En attente</p>
        <p class="text-2xl font-bold text-amber-400" id="statPending">—</p>
      </div>
      <div class="bg-slate-800 rounded-xl p-3 text-center">
        <p class="text-xs text-slate-400">Convs bloquées</p>
        <p class="text-2xl font-bold text-red-400" id="statBlocked">—</p>
      </div>
      <div class="bg-slate-800 rounded-xl p-3 text-center">
        <p class="text-xs text-slate-400">Débloquées</p>
        <p class="text-2xl font-bold text-emerald-400" id="statUnlocked">—</p>
      </div>
    </div>

    <!-- ONGLETS -->
    <div class="flex gap-2 border-b border-slate-700">
      <button id="tabPending" onclick="showTab('pending')" class="px-4 py-2 text-sm font-medium border-b-2 border-emerald-500 text-emerald-400">Demandes de paiement</button>
      <button id="tabAll" onclick="showTab('all')" class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-slate-400">Toutes les conversations</button>
      <button id="tabReports" onclick="showTab('reports')" class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-slate-400">Signalements</button>
    </div>

    <!-- PENDING -->
    <section id="secPending" class="space-y-3"></section>

    <!-- ALL CONVS -->
    <section id="secAll" class="space-y-3 hidden"></section>

    <!-- REPORTS -->
    <section id="secReports" class="space-y-3 hidden"></section>

  </main>

  <script>
    let currentUser = null;

    async function logout() {
      await supabaseClient.auth.signOut();
      window.location.href = 'index.html';
    }

    function showTab(name) {
      ['pending','all','reports'].forEach(t => {
        const btn = document.getElementById('tab' + t.charAt(0).toUpperCase() + t.slice(1));
        const sec = document.getElementById('sec' + t.charAt(0).toUpperCase() + t.slice(1));
        if (t === name) {
          btn.className = 'px-4 py-2 text-sm font-medium border-b-2 border-emerald-500 text-emerald-400';
          sec.classList.remove('hidden');
        } else {
          btn.className = 'px-4 py-2 text-sm font-medium border-b-2 border-transparent text-slate-400';
          sec.classList.add('hidden');
        }
      });
    }

    function fmtDate(s) { return new Date(s).toLocaleString('fr-FR'); }

    async function loadStats() {
      const { count: pending } = await supabaseClient
        .from('payments').select('*', { count: 'exact', head: true }).eq('status', 'pending');
      const { count: blocked } = await supabaseClient
        .from('conversations').select('*', { count: 'exact', head: true })
        .eq('is_unlocked', false).gte('message_count', 10);
      const { count: unlocked } = await supabaseClient
        .from('conversations').select('*', { count: 'exact', head: true }).eq('is_unlocked', true);

      document.getElementById('statPending').textContent = pending || 0;
      document.getElementById('statBlocked').textContent = blocked || 0;
      document.getElementById('statUnlocked').textContent = unlocked || 0;
    }

    async function loadPending() {
      const box = document.getElementById('secPending');
      box.innerHTML = '<p class="text-slate-400 text-center py-6">Chargement…</p>';

      const { data: pays } = await supabaseClient
        .from('payments').select('*').eq('status', 'pending')
        .order('created_at', { ascending: false });

      if (!pays || !pays.length) {
        box.innerHTML = '<p class="text-slate-500 text-center py-10">Aucune demande en attente. ✅</p>';
        return;
      }

      // Récupérer infos user + conv
      const userIds = [...new Set(pays.map(p => p.user_id))];
      const convIds = [...new Set(pays.map(p => p.conversation_id))];
      const { data: users } = await supabaseClient.from('profiles').select('id, username').in('id', userIds);
      const { data: convs } = await supabaseClient.from('conversations').select('*').in('id', convIds);

      box.innerHTML = pays.map(p => {
        const u = users?.find(x => x.id === p.user_id);
        const c = convs?.find(x => x.id === p.conversation_id);
        return `
          <div class="bg-slate-800 rounded-xl p-4 border border-slate-700">
            <div class="flex justify-between items-start mb-2">
              <div>
                <p class="font-semibold text-emerald-400">${u?.username || 'Utilisateur inconnu'}</p>
                <p class="text-xs text-slate-400">Demandé le ${fmtDate(p.created_at)}</p>
                <p class="text-xs text-slate-400">Fournisseur : <b>${p.provider}</b> · Montant : <b>${p.amount} ${p.currency}</b></p>
              </div>
              <span class="text-xs bg-amber-500/20 text-amber-400 px-2 py-1 rounded-full">En attente</span>
            </div>
            <div class="flex gap-2 mt-3">
              <button onclick="approve('${p.id}')" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white py-2 rounded-lg text-sm font-semibold">
                ✅ Approuver & débloquer
              </button>
              <button onclick="reject('${p.id}')" class="bg-red-600/30 hover:bg-red-600/50 text-red-300 py-2 px-3 rounded-lg text-sm">
                ❌ Refuser
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    async function loadAll() {
      const box = document.getElementById('secAll');
      box.innerHTML = '<p class="text-slate-400 text-center py-6">Chargement…</p>';

      const { data: convs } = await supabaseClient
        .from('conversations').select('*')
        .order('last_message_at', { ascending: false }).limit(50);

      if (!convs || !convs.length) {
        box.innerHTML = '<p class="text-slate-500 text-center py-10">Aucune conversation.</p>';
        return;
      }

      const ids = [...new Set([...convs.map(c=>c.participant_one), ...convs.map(c=>c.participant_two)])];
      const { data: users } = await supabaseClient.from('profiles').select('id, username').in('id', ids);

      box.innerHTML = convs.map(c => {
        const p1 = users?.find(u => u.id === c.participant_one);
        const p2 = users?.find(u => u.id === c.participant_two);
        const locked = !c.is_unlocked && c.message_count >= 10;
        return `
          <div class="bg-slate-800 rounded-xl p-3 flex items-center justify-between">
            <div>
              <p class="font-medium text-sm">${p1?.username || '?'} ↔ ${p2?.username || '?'}</p>
              <p class="text-xs text-slate-400">${c.message_count} messages</p>
            </div>
            <div class="flex items-center gap-2">
              ${c.is_unlocked
                ? '<span class="text-xs bg-emerald-500/20 text-emerald-400 px-2 py-1 rounded-full">Illimité</span>'
                : locked
                  ? '<span class="text-xs bg-red-500/20 text-red-400 px-2 py-1 rounded-full">Bloqué</span>'
                  : '<span class="text-xs bg-slate-600/30 text-slate-400 px-2 py-1 rounded-full">En cours</span>'}
              ${locked ? `<button onclick="forceUnlock('${c.id}')" class="text-xs bg-emerald-600 hover:bg-emerald-700 px-2 py-1 rounded">Forcer</button>` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    async function loadReports() {
      const box = document.getElementById('secReports');
      box.innerHTML = '<p class="text-slate-400 text-center py-6">Chargement…</p>';

      const { data } = await supabaseClient.from('reports')
        .select('*').order('created_at', { ascending: false }).limit(50);

      if (!data || !data.length) {
        box.innerHTML = '<p class="text-slate-500 text-center py-10">Aucun signalement. ✅</p>';
        return;
      }

      const ids = [...new Set([...data.map(r=>r.reporter_id), ...data.map(r=>r.reported_id)])];
      const { data: users } = await supabaseClient.from('profiles').select('id, username').in('id', ids);

      box.innerHTML = data.map(r => {
        const rep = users?.find(u => u.id === r.reporter_id);
        const ted = users?.find(u => u.id === r.reported_id);
        return `
          <div class="bg-slate-800 rounded-xl p-3 border border-slate-700">
            <p class="text-xs text-slate-400">${fmtDate(r.created_at)}</p>
            <p class="font-medium text-sm"><span class="text-amber-400">${rep?.username || '?'}</span> signale <span class="text-red-400">${ted?.username || '?'}</span></p>
            <p class="text-sm mt-1">📝 ${r.reason}</p>
            ${r.details ? `<p class="text-xs text-slate-400 mt-1">${r.details}</p>` : ''}
          </div>
        `;
      }).join('');
    }

    async function approve(id) {
      if (!confirm('Confirmer le paiement et débloquer la conversation ?')) return;
      const { error } = await supabaseClient.rpc('admin_approve_payment', { p_payment_id: id });
      if (error) { alert('Erreur : ' + error.message); return; }
      alert('✅ Conversation débloquée !');
      refreshAll();
    }

    async function reject(id) {
      const note = prompt('Motif du refus (visible dans l\'admin uniquement) :') || '';
      const { error } = await supabaseClient.rpc('admin_reject_payment', { p_payment_id: id, p_note: note });
      if (error) { alert('Erreur : ' + error.message); return; }
      alert('❌ Demande refusée.');
      refreshAll();
    }

    async function forceUnlock(convId) {
      if (!confirm('Débloquer cette conversation SANS paiement ?')) return;
      const { error } = await supabaseClient.from('conversations')
        .update({ is_unlocked: true, unlocked_at: new Date().toISOString() })
        .eq('id', convId);
      if (error) { alert('Erreur : ' + error.message); return; }
      alert('✅ Débloqué !');
      refreshAll();
    }

    async function refreshAll() {
      loadStats(); loadPending(); loadAll(); loadReports();
    }

    (async () => {
      const { data: { user } } = await supabaseClient.auth.getUser();
      if (!user) { window.location.href = 'login.html'; return; }
      currentUser = user;

      // Vérifier que c'est bien un admin
      const { data: p } = await supabaseClient.from('profiles')
        .select('is_admin, username').eq('id', user.id).single();

      if (!p?.is_admin) {
        document.body.innerHTML = `
          <div class="min-h-screen flex items-center justify-center bg-slate-900 p-6">
            <div class="bg-red-500/10 border border-red-500/30 rounded-2xl p-6 text-center max-w-md">
              <p class="text-4xl mb-3">🚫</p>
              <h1 class="text-lg font-bold text-red-400 mb-2">Accès refusé</h1>
              <p class="text-sm text-slate-300 mb-4">Cette page est réservée à l'administrateur.</p>
              <a href="dashboard.html" class="text-emerald-400 underline text-sm">Retour au site</a>
            </div>
          </div>`;
        return;
      }

      refreshAll();
      setInterval(refreshAll, 20000);
    })();
  </script>
</body>
</html>
